          "text": [
            "\n",
            "--- PACKAGE DELIVERY VISUALIZATION ---\n",
            "\n",
            "Package 1  ->  B\n",
            "Package 2  ->  B\n",
            "Package 3  ->  C\n",
            "Package 4  ->  A\n",
            "\n",
            "City Load Status:\n",
            "A : 1 / 2\n",
            "B : 2 / 3\n",
            "C : 1 / 1\n",
            "\n",
            "--- CONSTRAINT CHECK ---\n",
            "All constraints satisfied ✓\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Task 2"
      ],
      "metadata": {
        "id": "zieCfRtCf3MP"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "regions = ['A', 'B', 'C', 'D']\n",
        "colors = ['Red', 'Green', 'Blue']\n",
        "\n",
        "# adjacency constraints\n",
        "neighbors = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['A', 'D'],\n",
        "    'C': ['A', 'D'],\n",
        "    'D': ['B', 'C']\n",
        "}\n",
        "\n",
        "# domain of each region\n",
        "domains = {r: colors[:] for r in regions}"
      ],
      "metadata": {
        "id": "AFg2iKwbf0gS"
      },
      "execution_count": 21,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from collections import deque\n",
        "\n",
        "\n",
        "# revise domains\n",
        "def revise(domains, xi, xj):\n",
        "\n",
        "    revised = False\n",
        "\n",
        "    for color in domains[xi][:]:\n",
        "        valid = False\n",
        "\n",
        "        for c in domains[xj]:\n",
        "            if color != c:\n",
        "                valid = True\n",
        "\n",
        "        if not valid:\n",
        "            domains[xi].remove(color)\n",
        "            revised = True\n",
        "\n",
        "    return revised\n",
        "\n",
        "\n",
        "# AC3 constraint propagation\n",
        "def ac3(domains):\n",
        "\n",
        "    queue = deque()\n",
        "\n",
        "    for xi in neighbors:\n",
        "        for xj in neighbors[xi]:\n",
        "            queue.append((xi, xj))\n",
        "\n",
        "    while queue:\n",
        "        xi, xj = queue.popleft()\n",
        "\n",
        "        if revise(domains, xi, xj):\n",
        "\n",
        "            if len(domains[xi]) == 0:\n",
        "                return False\n",
        "\n",
        "            for xk in neighbors[xi]:\n",
        "                if xk != xj:\n",
        "                    queue.append((xk, xi))\n",
        "\n",
        "    return True"
      ],
      "metadata": {
        "id": "QjugxHQPgAdQ"
      },
      "execution_count": 22,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# check if assignment valid\n",
        "def consistent(region, color, assignment):\n",
        "\n",
        "    for n in neighbors[region]:\n",
        "        if n in assignment and assignment[n] == color:\n",
        "            return False\n",
        "\n",
        "    return True\n",
        "\n",
        "\n",
        "def backtrack(assignment):\n",
        "\n",
        "    if len(assignment) == len(regions):\n",
        "        return assignment\n",
        "\n",
        "    for r in regions:\n",
        "        if r not in assignment:\n",
        "            region = r\n",
        "            break\n",
        "\n",
        "    for color in domains[region]:\n",
        "\n",
        "        if consistent(region, color, assignment):\n",
        "\n",
        "            assignment[region] = color\n",
        "\n",
        "            result = backtrack(assignment)\n",
        "\n",
        "            if result:\n",
        "                return result\n",
        "\n",
        "            del assignment[region]\n",
        "\n",
        "    return None"
      ],
      "metadata": {
        "id": "EFtSyR8TgDMz"
      },
      "execution_count": 23,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# apply arc consistency before search\n",
        "ac3(domains)\n",
        "\n",
        "print(\"Domains after AC3:\")\n",
        "print(domains)\n",
        "\n",
        "solution = backtrack({})\n",
        "\n",
        "print(\"\\nMap Coloring Solution:\")\n",
        "for r in solution:\n",
        "    print(r, \"->\", solution[r])"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "AjPyUwu7gGFX",
        "outputId": "78a99fbd-5506-4113-b180-ca30ab67c93e"
      },
      "execution_count": 24,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Domains after AC3:\n",
            "{'A': ['Red', 'Green', 'Blue'], 'B': ['Red', 'Green', 'Blue'], 'C': ['Red', 'Green', 'Blue'], 'D': ['Red', 'Green', 'Blue']}\n",
            "\n",
            "Map Coloring Solution:\n",
            "A -> Red\n",
            "B -> Green\n",
            "C -> Green\n",
            "D -> Red\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "print(\"\\n--- MAP COLORING VISUALIZATION ---\\n\")\n",
        "\n",
        "for r in regions:\n",
        "    print(\"Region\", r, \"->\", solution[r])\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "print(\"\\n--- ADJACENT REGION COLOR CHECK ---\\n\")\n",
        "\n",
        "checked = set()\n",
        "valid = True\n",
        "\n",
        "for r in neighbors:\n",
        "    for n in neighbors[r]:\n",
        "\n",
        "        # avoid duplicate printing like A-B and B-A\n",
        "        if (n, r) in checked:\n",
        "            continue\n",
        "\n",
        "        color_r = solution[r]\n",
        "        color_n = solution[n]\n",
        "\n",
        "        print(r, \"(\", color_r, \")  <->  \", n, \"(\", color_n, \")\", end=\"  \")\n",
        "\n",
        "        if color_r != color_n:\n",
        "            print(\"✓ OK\")\n",
        "        else:\n",
        "            print(\"✗ SAME COLOR\")\n",
        "            valid = False\n",
        "\n",
        "        checked.add((r, n))\n",
        "\n",
        "\n",
        "\n",
        "print(\"\\n--- FINAL RESULT ---\")\n",
        "\n",
        "if valid:\n",
        "    print(\"All adjacency constraints satisfied ✓\")\n",
        "else:\n",
        "    print(\"Some constraints violated ✗\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "6U6JgtlpgIph",
        "outputId": "9367f382-3f35-4c81-c867-58b554afddac"
      },
      "execution_count": 26,
      "outputs": [
        {
          "output_type": "stream",
