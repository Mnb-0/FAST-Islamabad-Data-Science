  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "## Task 1"
      ],
      "metadata": {
        "id": "BkIbAMOIf5Zi"
      }
    },
    {
      "cell_type": "code",
      "execution_count": 16,
      "metadata": {
        "id": "3vygs4-ye8O-"
      },
      "outputs": [],
      "source": [
        "# Packages and cities\n",
        "packages = [1, 2, 3, 4]\n",
        "cities = ['A', 'B', 'C']\n",
        "\n",
        "# capacity of each city\n",
        "capacity = {\n",
        "    'A': 2,\n",
        "    'B': 3,\n",
        "    'C': 1\n",
        "}\n",
        "\n",
        "# allowed cities for each package\n",
        "allowed = {\n",
        "    1: ['A', 'B'],\n",
        "    2: ['B', 'C'],\n",
        "    3: ['A', 'C'],\n",
        "    4: ['A']\n",
        "}"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# function to check city capacity\n",
        "def capacity_ok(assignments, city):\n",
        "    count = 0\n",
        "    for p in assignments:\n",
        "        if assignments[p] == city:\n",
        "            count += 1\n",
        "    return count <= capacity[city]\n",
        "\n",
        "\n",
        "# forward checking to remove invalid choices\n",
        "def forward_check(domains, assignments):\n",
        "\n",
        "    new_domains = {p: list(domains[p]) for p in domains}\n",
        "\n",
        "    # check if any city already full\n",
        "    for city in cities:\n",
        "        used = list(assignments.values()).count(city)\n",
        "\n",
        "        if used >= capacity[city]:\n",
        "            for p in new_domains:\n",
        "                if city in new_domains[p]:\n",
        "                    new_domains[p].remove(city)\n",
        "\n",
        "    return new_domains\n",
        "\n",
        "\n",
        "# backtracking search with forward checking\n",
        "def solve(packages, domains, assignments):\n",
        "\n",
        "    # if all packages assigned\n",
        "    if len(assignments) == len(packages):\n",
        "        return assignments\n",
        "\n",
        "    # select next package\n",
        "    for p in packages:\n",
        "        if p not in assignments:\n",
        "            package = p\n",
        "            break\n",
        "\n",
        "    for city in domains[package]:\n",
        "\n",
        "        assignments[package] = city\n",
        "\n",
        "        if capacity_ok(assignments, city):\n",
        "\n",
        "            new_domains = forward_check(domains, assignments)\n",
        "\n",
        "            # check if any domain empty\n",
        "            fail = False\n",
        "            for d in new_domains.values():\n",
        "                if len(d) == 0:\n",
        "                    fail = True\n",
        "\n",
        "            if not fail:\n",
        "                result = solve(packages, new_domains, assignments)\n",
        "                if result:\n",
        "                    return result\n",
        "\n",
        "        del assignments[package]\n",
        "\n",
        "    return None"
      ],
      "metadata": {
        "id": "z2RkGbfefCK3"
      },
      "execution_count": 17,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# initial domains\n",
        "domains = {p: allowed[p][:] for p in packages}\n",
        "\n",
        "solution = solve(packages, domains, {})\n",
        "\n",
        "print(\"Package Assignment:\")\n",
        "for p in solution:\n",
        "    print(\"Package\", p, \"-> City\", solution[p])"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "OljkjAVafxrQ",
        "outputId": "1d29fe2a-549e-4f98-ffb5-3050a1f211cd"
      },
      "execution_count": 18,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Package Assignment:\n",
            "Package 1 -> City B\n",
            "Package 2 -> City B\n",
            "Package 3 -> City C\n",
            "Package 4 -> City A\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "print(\"\\n--- PACKAGE DELIVERY VISUALIZATION ---\\n\")\n",
        "\n",
        "# show which package goes where\n",
        "for p in packages:\n",
        "    print(\"Package\", p, \" -> \", solution[p])\n",
        "\n",
        "print(\"\\nCity Load Status:\")\n",
        "\n",
        "# count packages per city\n",
        "city_load = {c:0 for c in cities}\n",
        "\n",
        "for p in solution:\n",
        "    city_load[solution[p]] += 1\n",
        "\n",
        "for c in cities:\n",
        "    print(c, \":\", city_load[c], \"/\", capacity[c])\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "print(\"\\n--- CONSTRAINT CHECK ---\")\n",
        "\n",
        "valid = True\n",
        "\n",
        "# check allowed cities\n",
        "for p in solution:\n",
        "    if solution[p] not in allowed[p]:\n",
        "        print(\"Invalid: Package\", p, \"sent to disallowed city\")\n",
        "        valid = False\n",
        "\n",
        "# check capacity\n",
        "for c in cities:\n",
        "    if city_load[c] > capacity[c]:\n",
        "        print(\"Invalid: Capacity exceeded in city\", c)\n",
        "        valid = False\n",
        "\n",
        "# check each package assigned once\n",
        "if len(solution) != len(packages):\n",
        "    print(\"Invalid: Some packages unassigned\")\n",
        "    valid = False\n",
        "\n",
        "if valid:\n",
        "    print(\"All constraints satisfied ✓\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Ks3lGN-Khr1G",
        "outputId": "bdb62035-0e56-4a8d-d271-43b25ec6e87f"
      },
      "execution_count": 20,
      "outputs": [
        {
          "output_type": "stream",
