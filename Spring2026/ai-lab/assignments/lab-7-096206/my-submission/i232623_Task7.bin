          "text": [
            "\n",
            "--- MAP COLORING VISUALIZATION ---\n",
            "\n",
            "Region A -> Red\n",
            "Region B -> Green\n",
            "Region C -> Green\n",
            "Region D -> Red\n",
            "\n",
            "--- ADJACENT REGION COLOR CHECK ---\n",
            "\n",
            "A ( Red )  <->   B ( Green )  ✓ OK\n",
            "A ( Red )  <->   C ( Green )  ✓ OK\n",
            "B ( Green )  <->   D ( Red )  ✓ OK\n",
            "C ( Green )  <->   D ( Red )  ✓ OK\n",
            "\n",
            "--- FINAL RESULT ---\n",
            "All adjacency constraints satisfied ✓\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
